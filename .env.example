# No secrets needed in default mode. Set these in the process environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional local all-MiniLM-L6-v2 model directory (never auto-download).
BO1_EMBEDDING_MODEL=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-local-password
NEO4J_DATABASE=neo4j
